# Copy to .env.tests.local (never committed) to run the tests from this computer.
# NEVER put production values here: only the Supabase TEST project.
# distant = the linked Supabase project (`supabase link`), locale = `supabase start`.
TESTS_BASE=distant
# Supabase CLI 2.121 or later (the one in node_modules is older and has no `db query`).
SUPABASE_CLI=supabase
# Real client journey (npm run test:e2e:parcours): URL and PUBLIC key of the same test project.
E2E_SUPABASE_URL=
E2E_SUPABASE_KEY=
# Supabase Auth test number of the project (fixed code, no SMS), also in TEST_PHONE_NUMBERS.
E2E_TELEPHONE=
E2E_CODE=
